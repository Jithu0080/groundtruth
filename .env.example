# Copy to .env (git-ignored) or set in your shell. Only needed for `generate-eval`.
# Retrieval evaluation and tests need none of these.

# anthropic | openai   (openai = any OpenAI-compatible endpoint, including local Ollama)
GT_LLM_PROVIDER=anthropic
GT_LLM_MODEL=
# Prefer a different model from GT_LLM_MODEL to reduce self-preference bias
GT_JUDGE_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
